# Database
DATABASE_URL="postgresql://ab:ab@localhost:5432/automotive_brands?schema=public"

# App
APP_URL="http://localhost:43127"
NODE_ENV="development"

# Auth — generate a long random string for production
# openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-to-a-long-random-string!!"

# Development seed only (never used in client bundles)
# DEV_SEED_PASSWORD="DevOnly-ChangeMe-Phase1!"
# ALLOW_PRODUCTION_SEED="true"  # dangerous — ops only; never for Coolify

# ---------------------------------------------------------------------------
# Production first-admin bootstrap (optional, one-time)
# Set on first Coolify deploy, then REMOVE INITIAL_ADMIN_PASSWORD afterwards.
# Does not reset an existing admin password on later deploys.
# ---------------------------------------------------------------------------
# INITIAL_ADMIN_EMAIL="you@yourcompany.co.uk"
# INITIAL_ADMIN_NAME="Your Name"
# INITIAL_ADMIN_PASSWORD=""   # min 10 chars; never commit a real value

# ---------------------------------------------------------------------------
# Future / optional — leave blank until the related phase
# ---------------------------------------------------------------------------

# Redis (rate limiting / jobs — not required for Phase 0)
# REDIS_URL="redis://localhost:6379"

# Object storage (documents, SDS, imagery)
# OBJECT_STORAGE_ENDPOINT="https://s3.example.com"
# OBJECT_STORAGE_BUCKET="automotive-brands"
# OBJECT_STORAGE_ACCESS_KEY=""
# OBJECT_STORAGE_SECRET_KEY=""
# OBJECT_STORAGE_REGION="eu-west-2"

# ---------------------------------------------------------------------------
# CMS media — Cloudflare R2 / S3-compatible (optional)
# If unset, uploads are stored in Postgres (survives Coolify deploys).
# Never store media only on the container filesystem.
# ---------------------------------------------------------------------------
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="automotive-brands-cms"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://media.example.com"

# Transactional email (Phase 2+). In development the dev-log adapter is used.
# In production without a provider, reset emails are refused (not silently faked).
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="trade@automotivebrands.co.uk"

# ---------------------------------------------------------------------------
# Autopart 231PO3NEW stock (Phase 5 / 5A)
# PRODUCTION SOURCE = EMAIL / IMAP (not FTP/HTTP).
# Coolify: POST /api/internal/stock-sync (UTC ticks are fine).
# The app only IMPORTS at 09:00 / 12:00 / 15:00 / 18:00 Europe/London.
# Do not also enable AUTOPART_STOCK_ENABLE_SCHEDULER if Coolify cron is used.
# Deployment does NOT import stock. Test connection → poll dry-run → live sync.
# Never put these secrets in VITE_* variables.
# ---------------------------------------------------------------------------
# AUTOPART_STOCK_SOURCE="email"
# AUTOPART_STOCK_IMAP_HOST=""
# AUTOPART_STOCK_IMAP_PORT="993"
# AUTOPART_STOCK_IMAP_SECURE="true"
# AUTOPART_STOCK_IMAP_USER=""
# AUTOPART_STOCK_IMAP_PASSWORD=""
# AUTOPART_STOCK_IMAP_MAILBOX="INBOX"
# AUTOPART_STOCK_IMAP_ALLOWED_SENDERS=""
# AUTOPART_STOCK_IMAP_FILENAME_PATTERN="231PO3NEW*.txt"
# AUTOPART_STOCK_STALE_HOURS="36"
# AUTOPART_STOCK_CRON_SECRET=""
# AUTOPART_STOCK_ENABLE_SCHEDULER="false"
# AUTOPART_STOCK_MAX_BYTES="15000000"

# Diagnostic adapters only (not production):
# AUTOPART_STOCK_FTP_HOST=""
# AUTOPART_STOCK_HTTP_URL=""
# AUTOPART_STOCK_FILE_PATH=""

# Legacy Autopart API placeholders (not used for 231PO3NEW Avail)
# AUTOPART_BASE_URL=""
# AUTOPART_API_KEY=""
# AUTOPART_COMPANY_CODE=""

# Card payments (not in Phase 0)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
