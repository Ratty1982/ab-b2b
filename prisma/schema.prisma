  seoTitle    String?
  metaDescription String?
  createdById String?
  createdAt   DateTime @default(now())

  page     CmsPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sections CmsSection[]
  draftFor     CmsPage? @relation("CmsPageDraft")
  publishedFor CmsPage? @relation("CmsPagePublished")
  publishEvents CmsPublishEvent[]

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model CmsSection {
  id        String         @id @default(cuid())
  versionId String
  type      CmsSectionType
  /// Validated JSON config — never executable code
  config    Json
  sortOrder Int            @default(0)
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  version CmsPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, sortOrder])
}

model CmsMedia {
  id           String   @id @default(cuid())
  filename     String
  contentType  String
  sizeBytes    Int?
  width        Int?
  height       Int?
  altText      String?
  /// Object-storage key or abstract URI — not a local filesystem path contract
  storageKey   String
  storageProvider String @default("local")
  /// Image bytes for the local/database provider (survives Coolify without S3)
  bytes        Bytes?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandLogos    Brand[]        @relation("BrandLogo")
  categoryImages Category[]    @relation("CategoryImage")
  productMedia  ProductMedia[] @relation("ProductMedia")
  teamPhotos    TeamMember[]   @relation("TeamMemberPhoto")
  salesRepPhotos SalesRep[]    @relation("SalesRepPhoto")

  @@index([contentType])
  @@index([uploadedById])
}

model TeamDepartment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  /// When false, department and its members are omitted from public pages.
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]

  @@index([sortOrder])
  @@index([isPublic])
}

model TeamMember {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  jobTitle      String?
  bio           String?
  /// Public contact email only — never copied from User automatically.
  email         String?
  /// Public telephone only — never copied from User automatically.
  phone         String?
  /// Public mobile only — never copied from User automatically.
  mobile        String?
  linkedInUrl   String?
  sortOrder     Int      @default(0)
  /// Defaults hidden until staff explicitly publish.
  isPublic      Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  /// When false, email/phone/LinkedIn must not appear in public HTML.
  isContactable Boolean  @default(false)
  departmentId  String?
  photoMediaId  String?
  photoAlt      String?
  photoFocalX   Int      @default(50)
  photoFocalY   Int      @default(50)
  /// Optional link to CRM SalesRep for future Account Manager presentation.
  salesRepId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  photoMedia CmsMedia?       @relation("TeamMemberPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  salesRep   SalesRep?       @relation(fields: [salesRepId], references: [id], onDelete: SetNull)

  @@index([departmentId, sortOrder])
  @@index([isPublic, isFeatured])
  @@index([sortOrder])
}

model CmsPublishEvent {
  id              String   @id @default(cuid())
  pageId          String
  versionId       String
  publishedById   String?
  note            String?
  createdAt       DateTime @default(now())

  page    CmsPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version CmsPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}
