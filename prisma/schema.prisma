// Automotive Brands — production foundation schema (Phase 0)
// PostgreSQL + Prisma. No seed business data in migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ActorType {
  INTERNAL
  TRADE
}

/// INTERNAL admin public-catalogue trade test pricing context.
/// NONE = ordering disabled; BASE_TRADE = ProductVariant.tradePrice;
/// PRICE_LIST = selected PriceList (tradeTestPriceListId).
enum TradeTestPricingMode {
  NONE
  BASE_TRADE
  PRICE_LIST
}

enum CompanyStatus {
  PROSPECT
  /// Product language: Pending (trade application / onboarding)
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  SUSPENDED
  CLOSED
}

enum TaxStatus {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUTSIDE_SCOPE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Distinguishes company portal invites from admin-created staff invitations.
enum InvitationKind {
  COMPANY_USER
  STAFF_USER
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsSectionType {
  HERO
  BRAND_LOGO_STRIP
  FEATURED_BRANDS
  CATEGORY_GRID
  FEATURED_PRODUCTS
  NEW_PRODUCTS
  POPULAR_PRODUCTS
  RESOURCES
  NEWS
  TEXT_IMAGE
  IMAGE_TEXT
  BENEFITS_GRID
  TRADE_CTA
  BANNER
  RICH_TEXT
  SPACER
  /// Homepage / marketing photographic motorsport feature band.
  MOTORSPORT_FEATURE
  /// Responsive media gallery (motorsport page and reusable CMS).
  MEDIA_GALLERY
}

/// Company-scoped trade access levels (distinct from system Role).
/// TRADE_ADMIN is the Phase 0 enum key for TRADE_ACCOUNT_ADMIN in product language.
enum CompanyUserRole {
  TRADE_ADMIN
  TRADE_BUYER
  TRADE_ACCOUNTS
  TRADE_READ_ONLY
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AddressType {
  TRADING
  DELIVERY
  BILLING
  REGISTERED
}

enum TradeApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum StockStatus {
  IN_STOCK
  LOW
  BACKORDER
  OUT_OF_STOCK
}

/// SKU backorder policy. INHERIT uses TradeOrderingSettings.defaultBackorderPolicy.
enum BackorderPolicy {
  INHERIT
  ALLOW
  DENY
}

/// Effective/global backorder decision (never INHERIT).
enum EffectiveBackorderPolicy {
  ALLOW
  DENY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductImportStatus {
  UPLOADED
  READY
  APPLIED
  FAILED
}

enum StockSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum StockIssueKind {
  UNMATCHED
  INVALID
  DUPLICATE
  PARSE
  CONFLICT
}

/// Operational severity for StockSyncIssue diagnostics.
/// IGNORED rows stay recorded for audit but do not drive dashboard health / PARTIAL.
enum StockIssueSeverity {
  IGNORED
  WARNING
  ACTION_REQUIRED
  FATAL
}

enum BasketStatus {
  OPEN
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PICKING
  /// Invoice evidence received but known backordered quantity may remain outstanding.
  PARTIALLY_DESPATCHED
  DISPATCHED
  DELIVERED
  CANCELLED
  ON_HOLD
}

/// Operational Autopart CSV handoff only — not fulfilment / despatch.
enum AutopartExportStatus {
  NOT_EXPORTED
  EXPORTED
}

/// Automotive Brands order-side stock hold (not an Autopart ERP reservation).
enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

/// Customer-visible fulfilment timeline — only store events backed by real data.
enum OrderFulfilmentEventKind {
  ORDER_RECEIVED
  EXPORTED_FOR_PROCESSING
  INVOICE_LINKED
  PART_DESPATCHED
  DESPATCHED
  NOTE
}

/// Historic Autopart document kinds (561L / SLRB). Not AB Orders.
enum AutopartHistoricDocumentType {
  INVOICE
  CREDIT
  PAYMENT
  JOURNAL
  UNKNOWN
}

enum AutopartHistoricLineMatchStatus {
  MATCHED
  NOT_IN_AB_CATALOGUE
}

enum AutopartCustomerImportType {
  HISTORY_561L_SLRB
  /// Ongoing Autopart all-branches 504 document feed.
  ONGOING_504
  /// Ongoing Autopart TRM21QC product-line sales/credit feed.
  ONGOING_TRM21QC
}

/// 504 ↔ TRM21QC document reconciliation (timing-tolerant).
enum AutopartSalesReconciliationStatus {
  AWAITING_504
  AWAITING_LINES
  MATCHED
  VALUE_MISMATCH
  UNKNOWN_DOCUMENT_TYPE
  COMPLETE
  UNMAPPED_CUSTOMER
}

enum AutopartCustomerImportStatus {
  PREVIEWED
  /// Confirm import in progress (not yet successful).
  PROCESSING
  COMMITTED
  FAILED
  BLOCKED
}

enum TransactionalEmailPurpose {
  ORDER_RECEIVED
  ORDER_RECEIVED_INTERNAL
  ORDER_PART_DESPATCHED
  ORDER_DESPATCHED
  QUOTE_SENT
  QUOTE_DECLINED_INTERNAL
  TRADE_APPLICATION_RECEIVED
  TRADE_APPLICATION_INTERNAL_NOTIFICATION
  TRADE_APPLICATION_MORE_INFO
  TRADE_APPLICATION_APPROVED
  TRADE_APPLICATION_REJECTED
  TRADE_ACCOUNT_ACTIVATED
  COMPANY_USER_INVITED
  USER_INVITATION
  PASSWORD_RESET
  MOTORSPORT_PARTNERSHIP_INTERNAL
  CALLBACK_REQUEST_INTERNAL
  EMAIL_TEST
}

/// SMTP security mode for outbound transactional email (Admin → Settings → Email).
enum SmtpSecurity {
  SSL_TLS
  STARTTLS
  NONE
}

enum TransactionalEmailStatus {
  PENDING
  SENT
  FAILED
  DEFERRED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  /// Customer declined (preferred over legacy REJECTED)
  DECLINED
  /// Legacy synonym — prefer DECLINED for new writes
  REJECTED
  EXPIRED
  CANCELLED
  /// Accepted quote successfully became an Order
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  VOID
}

/// Autopart 504C document classification.
enum AutopartDocumentKind {
  INVOICE
  CREDIT
  UNKNOWN
}

enum Autopart504cImportStatus {
  SUCCESS
  PARTIAL
  FAILED
  DRY_RUN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  NEW_LEAD
  QUALIFIED
  CONTACTED
  MEETING
  QUOTE_REQUIRED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  NOTE
  TASK
  FOLLOW_UP
  SYSTEM
  CALLBACK_REQUEST
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum DocumentVisibility {
  PUBLIC
  TRADE
  INTERNAL
}

/// Customer-facing / internal product file attachments (SDS, TDS, etc.).
enum ProductDocumentType {
  SAFETY_DATA_SHEET
  TECHNICAL_DATA_SHEET
  INSTRUCTIONS
  CERTIFICATE
  DECLARATION
  FITTING_GUIDE
  OTHER
}

/// Only CURRENT documents are shown publicly for a given type.
enum ProductDocumentStatus {
  CURRENT
  ARCHIVED
}

enum PromotionType {
  PERCENT
  FIXED
  QUANTITY_DEAL
}

// ─── Identity & access ───────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  /// Legacy / unused by Better Auth credential accounts (password lives on AuthAccount)
  passwordHash String?
  status       UserStatus @default(INVITED)
  actorType    ActorType  @default(TRADE)

  /// Better Auth core field (boolean). emailVerifiedAt retained for richer audit timestamps.
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  image           String?

  /// MFA-ready fields — enforcement planned for privileged roles (Phase 1+ docs)
  mfaEnabled     Boolean @default(false)
  mfaSecretEnc   String?
  mfaRecoveryEnc String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// INTERNAL only: admin public-catalogue trade test pricing mode.
  /// Never used for TRADE customers. Never invents a Company.
  tradeTestPricingMode TradeTestPricingMode @default(NONE)
  /// Required when tradeTestPricingMode = PRICE_LIST; otherwise null.
  tradeTestPriceListId String?
  tradeTestPriceList   PriceList? @relation("UserTradeTestPriceList", fields: [tradeTestPriceListId], references: [id], onDelete: SetNull)

  companyUsers       CompanyUser[]
  userRoles          UserRole[]
  salesRep           SalesRep?
  invitations        UserInvitation[]  @relation("InvitationUser")
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  activities         Activity[]
  notes              Note[]
  auditEvents        AuditEvent[]      @relation("AuditActor")
  auditEventsAsTarget AuditEvent[]     @relation("AuditTarget")
  tradeAppsReviewed  TradeApplication[] @relation("ApplicationReviewer")
  autopartCodesVerified Company[]       @relation("AutopartCodeVerifier")
  autopartOrdersExported Order[]        @relation("OrderAutopartExporter")
  autopartExportBatches  AutopartOrderExportBatch[] @relation("AutopartExportBatchCreator")
  autopart504cImportRuns Autopart504cImportRun[] @relation("Autopart504cImportCreator")
  autopartCustomerImportRuns AutopartCustomerImportRun[] @relation("AutopartCustomerImportCreator")
  autopartAccountAliasesVerified AutopartCustomerAccountAlias[] @relation("AutopartAliasVerifier")
  ownedLeads         Lead[]
  ownedOpportunities Opportunity[]
  sessions           AuthSession[]
  accounts           AuthAccount[]
  actingContexts     ActingContext[]   @relation("ActingActor")
  productImports     ProductImportJob[]
  testBaskets        Basket[]          @relation("AdminTestBasketOwner")

  @@index([actorType, status])
  @@index([tradeTestPriceListId])
}

/// Better Auth–compatible session table shape (wired in Phase 1)
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth–compatible account / provider linkage
model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth verification / password-reset tokens (never log `value`)
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Sales order-for-customer context (actor remains themselves — not classic impersonation)
model ActingContext {
  id                 String    @id @default(cuid())
  actorUserId        String
  onBehalfOfCompanyId String
  startedAt          DateTime  @default(now())
  endsAt             DateTime?
  endedAt            DateTime?
  reason             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actor            User    @relation("ActingActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  onBehalfOfCompany Company @relation(fields: [onBehalfOfCompanyId], references: [id], onDelete: Cascade)

  @@index([actorUserId, endedAt])
  @@index([onBehalfOfCompanyId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─── Companies & people ──────────────────────────────────────────────────────

model Company {
  id             String        @id @default(cuid())
  accountNumber  String?       @unique
  name           String
  tradingName    String?
  companyNumber  String?
  vatNumber      String?
  status         CompanyStatus @default(PROSPECT)
  taxStatus      TaxStatus     @default(STANDARD)
  paymentTerms   String?
  currency       String        @default("GBP")
  priceListId    String?
  /// Generic external ERP reference (legacy / non-Autopart). Prefer autopartCustomerCode for Autopart.
  externalRef    String?       @unique
  /// Verified Autopart customer/account code for future order handoff. Never a login secret.
  autopartCustomerCode            String?   @unique
  autopartCustomerCodeVerifiedAt  DateTime?
  autopartCustomerCodeVerifiedById String?
  website        String?
  phone          String?
  primaryEmail   String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  priceList      PriceList?    @relation(fields: [priceListId], references: [id])
  autopartCustomerCodeVerifiedBy User? @relation("AutopartCodeVerifier", fields: [autopartCustomerCodeVerifiedById], references: [id], onDelete: SetNull)
  users          CompanyUser[]
  contacts       Contact[]
  addresses      Address[]
  assignments    CompanyAssignment[]
  applications   TradeApplication[]
  invitations    UserInvitation[]
  customerPrices CustomerPrice[]
  baskets        Basket[]
  orders         Order[]
  quotes         Quote[]
  invoices       Invoice[]
  leads          Lead[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  notesList       Note[]
  documents       Document[]
  auditEvents     AuditEvent[]
  actingContexts  ActingContext[]
  autopartAccountAliases AutopartCustomerAccountAlias[]
  autopartSalesDocuments AutopartSalesDocument[]
  autopartSalesLines     AutopartSalesLine[]
  autopartCustomerImportRuns AutopartCustomerImportRun[]

  @@index([status])
  @@index([name])
  @@index([primaryEmail])
  @@index([autopartCustomerCode])
}

model CompanyUser {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyUserRole   @default(TRADE_BUYER)
  status    CompanyUserStatus @default(INVITED)
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Contact {
  id           String   @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  mobile       String?
  jobTitle     String?
  isPrimary    Boolean  @default(false)
  isPurchasing Boolean  @default(false)
  isAccounts   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model Address {
  id               String      @id @default(cuid())
  companyId        String
  type             AddressType @default(DELIVERY)
  label            String?
  line1            String
  line2            String?
  town             String
  county           String?
  postcode         String
  country          String      @default("GB")
  /// Legacy generic default — prefer isDefaultBilling / isDefaultDelivery
  isDefault        Boolean     @default(false)
  isDefaultBilling Boolean     @default(false)
  isDefaultDelivery Boolean    @default(false)
  contactName      String?
  contactPhone     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
  @@index([companyId, isDefaultBilling])
  @@index([companyId, isDefaultDelivery])
}

/// Portal / company-user invitation foundation (email delivery is optional later).
model UserInvitation {
  id              String            @id @default(cuid())
  kind            InvitationKind    @default(COMPANY_USER)
  /// Required for COMPANY_USER invites; null for STAFF_USER.
  companyId       String?
  /// Pre-created User for STAFF_USER (and optional for company invites).
  userId          String?
  email           String
  /// Company portal role — set for COMPANY_USER only.
  role            CompanyUserRole?
  /// System role key snapshot for STAFF_USER invites (display only; UserRole is authoritative).
  systemRoleKey   String?
  status          InvitationStatus  @default(PENDING)
  /// SHA-256 hex of the opaque invite token (never store raw token)
  tokenHash       String            @unique
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  /// When true, invite was created but outbound email was not sent (no provider)
  emailDeferred   Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([userId, status])
  @@index([email])
  @@index([expiresAt])
  @@index([kind, status])
}

model SalesRep {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String?  @unique
  region    String?
  /// Optional manager SalesRep for team-scoped access (SALES_MANAGER)
  managerId String?
  targetMtd Decimal? @db.Decimal(12, 2)
  active    Boolean  @default(true)
  /// Customer-facing display name. Falls back to linked User.name when blank.
  displayName String?
  /// Customer-facing job title (e.g. Account Manager).
  jobTitle String?
  /// Explicit customer-facing business email. Falls back to linked User.email when blank.
  businessEmail String?
  /// Customer-facing landline (string — preserves leading zeroes).
  phone String?
  /// Customer-facing mobile (string — preserves leading zeroes).
  mobile String?
  /// When false, portal/quotes must not expose SalesRep email/phone/mobile.
  customerContactEnabled Boolean @default(true)
  photoMediaId String?
  photoAlt     String?
  photoFocalX  Int     @default(50)
  photoFocalY  Int     @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager      SalesRep?           @relation("SalesRepTeam", fields: [managerId], references: [id])
  teamMembers  SalesRep[]          @relation("SalesRepTeam")
  assignments  CompanyAssignment[]
  applications TradeApplication[]
  publicTeamProfile TeamMember?
  photoMedia   CmsMedia?           @relation("SalesRepPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@index([managerId])
  @@index([photoMediaId])
}

model CompanyAssignment {
  id         String   @id @default(cuid())
  companyId  String
  salesRepId String
  /// Current account manager when true. At most one primary per company
  /// (enforced by partial unique index CompanyAssignment_companyId_isPrimary_unique).
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@unique([companyId, salesRepId])
  @@index([salesRepId])
}

model TradeApplication {
  id               String                 @id @default(cuid())
  reference        String                 @unique
  status           TradeApplicationStatus @default(SUBMITTED)
  companyId        String?
  companyName      String
  tradingName      String?
  companyNumber    String?
  vatNumber        String?
  businessType     String?
  website          String?
  tradingAddress   Json?
  deliveryAddress  Json?
  primaryContact   Json?
  accountsContact  Json?
  estimatedSpend   String?
  /// How the applicant heard about Automotive Brands (optional marketing insight).
  howHeardAboutUs  String?
  brandsInterest   String[]
  notes            String?
  reviewNotes      String?
  /// Customer-facing message for MORE_INFO_REQUIRED / optional rejection notice.
  customerMessage  String?
  /// yes | no | not_sure — claim about an existing Autopart/trade account.
  existingAccountClaim String?
  /// Applicant-claimed Autopart/account number — evidence only, never a verified ERP link.
  claimedAutopartCustomerCode String?
  /// When the applicant accepted privacy/terms acknowledgement on submit.
  consentAcceptedAt DateTime?
  assignedRepId    String?
  reviewedById     String?
  submittedAt      DateTime               @default(now())
  decidedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company    Company?  @relation(fields: [companyId], references: [id])
  assignedRep SalesRep? @relation(fields: [assignedRepId], references: [id])
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  Document[]

  @@index([status, submittedAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  logoMediaId String?
  logoAlt     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  logoMedia CmsMedia? @relation("BrandLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@index([logoMediaId])
  @@index([isActive, sortOrder])
}

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  parentId     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  imageMediaId String?
  imageAlt     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]
  imageMedia CmsMedia?  @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([imageMediaId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  brandId          String
  categoryId       String?
  description      String?
  shortDescription String?
  /// Spec rows: [{ name, value }]
  specifications   Json?
  isActive         Boolean       @default(true)
  status           ProductStatus @default(ACTIVE)
  isTradeVisible   Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  isNew            Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand     Brand            @relation(fields: [brandId], references: [id])
  category  Category?        @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  documents Document[]
  productDocuments ProductDocument[]
  media     ProductMedia[]
  tasks     Task[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status, isTradeVisible])
  @@index([updatedAt])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  barcode        String?
  mpn            String?
  name           String?
  packQty        Int      @default(1)
  caseQty        Int?
  minOrderQty    Int      @default(1)
  orderIncrement Int      @default(1)
  unit           String   @default("EA")
  weightKg       Decimal? @db.Decimal(10, 3)
  lengthMm       Decimal? @db.Decimal(10, 2)
  widthMm        Decimal? @db.Decimal(10, 2)
  heightMm       Decimal? @db.Decimal(10, 2)
  /// Base catalogue trade price (Phase 4 pricing engine replaces customer-facing calculation)
  tradePrice     Decimal? @db.Decimal(12, 4)
  rrp            Decimal? @db.Decimal(12, 2)
  vatCode        String   @default("STANDARD")
  /// External ERP / Autopart SKU
  externalRef    String?  @unique
  isDefault      Boolean  @default(true)
  isActive       Boolean  @default(true)
  /// INHERIT (default): use global trade ordering setting. ALLOW/DENY override per SKU.
  backorderPolicy BackorderPolicy @default(INHERIT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  priceListItems PriceListItem[]
  customerPrices CustomerPrice[]
  quantityBreaks QuantityBreak[]
  basketItems    BasketItem[]
  orderItems     OrderItem[]
  quoteItems       QuoteItem[]
  stockSyncChanges StockSyncChange[]
  autopartCostPosition AutopartProductCostPosition?
  autopartCostSnapshots AutopartProductCostSnapshot[]
  autopartUsageSnapshots AutopartProductUsageSnapshot[]

  @@index([productId])
  @@index([barcode])
  @@index([mpn])
  @@index([backorderPolicy])
}

/// Product ↔ CMS media. Detach does not delete CmsMedia.
model ProductMedia {
  id         String   @id @default(cuid())
  productId  String
  mediaId    String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  altText    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   CmsMedia @relation("ProductMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}

model ProductImportJob {
  id                String              @id @default(cuid())
  filename          String
  uploadedById      String
  status            ProductImportStatus @default(UPLOADED)
  rowCount          Int                 @default(0)
  createdCount      Int                 @default(0)
  updatedCount      Int                 @default(0)
  skippedCount      Int                 @default(0)
  errorCount        Int                 @default(0)
  warningCount      Int                 @default(0)
  /// Column header → canonical field key
  mapping           Json
  unknownBrands     Json?
  unknownCategories Json?
  /// Parsed rows + preview summary (not the raw CSV)
  preview           Json?
  result            Json?
  errorReport       String?
  sourceHash        String?
  /// Original file text for remapping; kept off the preview JSON blob
  sourceCsv         String? @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  appliedAt         DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([uploadedById])
  @@index([status])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
}

model Inventory {
  id               String      @id @default(cuid())
  variantId        String
  warehouseId      String
  /// Latest Autopart Avail (authoritative on-hand from 231PO3NEW). Sync updates this only.
  qtyOnHand        Int         @default(0)
  /// Sum of ACTIVE Automotive Brands OrderStockReservation quantities.
  /// Sync must NEVER reset qtyReserved — effective sellable = max(0, qtyOnHand - qtyReserved).
  qtyReserved      Int         @default(0)
  status           StockStatus @default(IN_STOCK)
  /// When true, UI may show status but exact qty is trade-only policy elsewhere
  updatedAt        DateTime    @updatedAt
  /// Optional Autopart sync stamp
  externalSyncedAt DateTime?
  /// Raw Avail from 231PO3NEW for diagnostics (may be negative); qtyOnHand is the clamped Avail.
  sourceAvailRaw   String?

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reservations OrderStockReservation[]

  @@unique([variantId, warehouseId])
  @@index([status])
}

model StockSyncRun {
  id             String          @id @default(cuid())
  source         String
  mode           String
  status         StockSyncStatus @default(RUNNING)
  trigger        String
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  rowsRead       Int             @default(0)
  matched        Int             @default(0)
  updated        Int             @default(0)
  unchanged      Int             @default(0)
  unmatched      Int             @default(0)
  invalid        Int             @default(0)
  duplicates     Int             @default(0)
  absentFromFeed Int             @default(0)
  errorSummary   String?
  /// Internal commercial diagnostics from Latest Cost / usage capture (not stock health).
  commercialJson Json?
  actorUserId    String?
  durationMs     Int?
  createdAt      DateTime        @default(now())

  issues  StockSyncIssue[]
  changes StockSyncChange[]

  @@index([startedAt])
  @@index([status, startedAt])
}

/// Live Autopart quantity change (old → new). Unchanged SKUs and unmatched
/// Autopart SKUs are not stored here. Dry-run never writes this table.
model StockSyncChange {
  id                   String   @id @default(cuid())
  runId                String
  variantId            String?
  productId            String?
  skuSnapshot          String
  productNameSnapshot  String
  variantLabelSnapshot String?
  previousQty          Int
  newQty               Int
  previousAvailability String
  newAvailability      String
  createdAt            DateTime @default(now())

  run     StockSyncRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([variantId])
  @@index([createdAt])
}

model StockSyncIssue {
  id          String              @id @default(cuid())
  runId       String
  kind        StockIssueKind
  /// Operational severity — INVALID/DUPLICATE feed noise is IGNORED for dashboard health.
  severity    StockIssueSeverity  @default(IGNORED)
  sku         String?
  description String?
  availRaw    String?
  message     String
  line        Int?
  createdAt   DateTime            @default(now())

  run StockSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
  @@index([runId, severity])
}

model StockFeedUnmatched {
  sku              String   @id
  description      String?
  lastAvailRaw     String?
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  lastRunId        String
  occurrenceCount  Int      @default(1)
  reason           String

  @@index([lastSeenAt])
}

/// Current Autopart Latest Cost position per SKU (internal commercial intelligence).
/// NEVER expose to trade portal / public catalogue.
model AutopartProductCostPosition {
  id               String   @id @default(cuid())
  sku              String   @unique
  productVariantId String?  @unique
  latestCost       Decimal  @db.Decimal(12, 4)
  previousCost     Decimal? @db.Decimal(12, 4)
  firstObservedAt  DateTime
  lastObservedAt   DateTime
  lastChangedAt    DateTime?
  sourceImportedAt DateTime
  sourceSyncRunId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([lastChangedAt])
  @@index([sourceSyncRunId])
}

/// One authoritative Latest Cost observation per SKU per Europe/London business date.
/// Multiple polls the same day upsert this row (latest poll wins).
model AutopartProductCostSnapshot {
  id               String   @id @default(cuid())
  sku              String
  productVariantId String?
  /// Civil date YYYY-MM-DD in Europe/London (stored as Date at UTC midnight of that civil date).
  businessDate     DateTime @db.Date
  latestCost       Decimal  @db.Decimal(12, 4)
  sourceImportedAt DateTime
  sourceSyncRunId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@unique([sku, businessDate])
  @@index([productVariantId, businessDate])
  @@index([businessDate])
  @@index([sourceSyncRunId])
}

/// Daily product usage / stock-column snapshot from 231PO3NEW.
/// Ryr / Curr / Mth* retain Autopart source field names — period semantics
/// are NOT interpreted until confirmed with Autopart. Stk / Pick Qty /
/// Physical Stk are diagnostic only (Avail remains sellable stock authority).
model AutopartProductUsageSnapshot {
  id               String   @id @default(cuid())
  sku              String
  productVariantId String?
  businessDate     DateTime @db.Date
  stk              Decimal? @db.Decimal(14, 4)
  pickQty          Decimal? @db.Decimal(14, 4)
  physicalStk      Decimal? @db.Decimal(14, 4)
  /// Autopart source field "Ryr" — meaning to be confirmed.
  ryr              Decimal? @db.Decimal(14, 4)
  /// Autopart source field "Curr" — meaning to be confirmed.
  curr             Decimal? @db.Decimal(14, 4)
  mth1             Decimal? @db.Decimal(14, 4)
  mth2             Decimal? @db.Decimal(14, 4)
  mth3             Decimal? @db.Decimal(14, 4)
  mth4             Decimal? @db.Decimal(14, 4)
  mth5             Decimal? @db.Decimal(14, 4)
  mth6             Decimal? @db.Decimal(14, 4)
  mth7             Decimal? @db.Decimal(14, 4)
  mth8             Decimal? @db.Decimal(14, 4)
  mth9             Decimal? @db.Decimal(14, 4)
  mth10            Decimal? @db.Decimal(14, 4)
  mth11            Decimal? @db.Decimal(14, 4)
  mth12            Decimal? @db.Decimal(14, 4)
  sourceImportedAt DateTime
  sourceSyncRunId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@unique([sku, businessDate])
  @@index([productVariantId, businessDate])
  @@index([businessDate])
  @@index([sourceSyncRunId])
}

/// Single-row mutex so Autopart imports cannot overlap (Prisma-safe; not Redis).
model StockSyncMutex {
  id       String    @id
  holder   String?
  lockedAt DateTime?
}

/// In-application Autopart scheduler health (tick timestamps; not secrets).
model StockScheduleState {
  id         String    @id @default("singleton")
  startedAt  DateTime?
  lastTickAt DateTime?
  lastDueKey String?
}

/// One row per Autopart business window (Europe/London date + 09/12/15/18).
model StockScheduleWindow {
  key           String    @id
  businessDate  String
  hour          Int
  status        String
  lastAttemptAt DateTime?
  completedAt   DateTime?
  lastRunId     String?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessDate])
  @@index([status])
}

/// Outbound transactional email settings (Admin → Settings → Email).
/// SMTP password is write-only: stored AES-256-GCM encrypted; never returned to clients.
/// Singleton trade ordering defaults (backorders, etc.).
model TradeOrderingSettings {
  id                     String                   @id @default("singleton")
  /// Global default when ProductVariant.backorderPolicy is INHERIT.
  defaultBackorderPolicy EffectiveBackorderPolicy @default(ALLOW)
  updatedByUserId        String?
  updatedAt              DateTime                 @updatedAt
}

model EmailSettings {
  id                           String       @id @default("singleton")
  enabled                      Boolean      @default(false)
  smtpHost                     String?
  smtpPort                     Int          @default(465)
  smtpSecurity                 SmtpSecurity @default(SSL_TLS)
  smtpUsername                 String?
  smtpPasswordEncrypted        String?
  fromName                     String?
  fromEmail                    String?
  replyToName                  String?
  replyToEmail                 String?
  /// JSON string array of email addresses for new trade application alerts.
  tradeApplicationRecipients   Json         @default("[]")
  /// JSON string array of email addresses for new B2B order alerts.
  orderNotificationRecipients  Json         @default("[]")
  /// JSON string array for motorsport partnership enquiry alerts.
  motorsportEnquiryRecipients  Json         @default("[]")
  lastConnectionTestAt         DateTime?
  lastConnectionTestOk         Boolean?
  lastConnectionTestError      String?
  lastTestEmailAt              DateTime?
  lastTestEmailOk              Boolean?
  lastTestEmailError           String?
  updatedByUserId              String?
  updatedAt                    DateTime     @updatedAt
  createdAt                    DateTime     @default(now())
}

/// Operational IMAP settings. Password is write-only (encrypted or env-backed).
model AutopartImapSettings {
  id                         String    @id @default("singleton")
  enabled                    Boolean   @default(false)
  inboundEmailAddress        String    @default("")
  imapHost                   String?
  imapPort                   Int       @default(993)
  imapSecure                 Boolean   @default(true)
  imapUsername               String?
  imapPasswordEncrypted      String?
  mailbox                    String    @default("INBOX")
  allowedSenderEmails        String    @default("")
  attachmentFilenamePattern  String    @default("231PO3NEW*.txt")
  pollIntervalMinutes        Int       @default(15)
  lookbackDays               Int       @default(14)
  maxMessages                Int       @default(100)
  autoArchiveProcessedEmails Boolean   @default(false)
  lastPollAt                 DateTime?
  lastPollError              String?
  lastEmailFrom              String?
  lastEmailSubject           String?
  lastEmailUid               String?
  lastAttachmentFilename     String?
  lastEmailReceivedAt        DateTime?
  updatedAt                  DateTime  @updatedAt
}

/// Processed IMAP receipts. Identity is UID + Message-ID, never Message-ID alone.
model StockEmailReceipt {
  id              String   @id @default(cuid())
  receiptKey      String   @unique
  emailUid        String
  emailMessageId  String?
  fromAddress     String
  subject         String
  receivedAt      DateTime
  attachmentFilename String?
  consumed        Boolean  @default(false)
  runId           String?
  createdAt       DateTime @default(now())

  @@index([emailUid])
  @@index([emailMessageId])
  @@index([consumed])
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PriceList {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  currency    String   @default("GBP")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          PriceListItem[]
  companies      Company[]
  tradeTestUsers User[]          @relation("UserTradeTestPriceList")
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  variantId   String
  unitPrice   Decimal  @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
}

model CustomerPrice {
  id        String   @id @default(cuid())
  companyId String
  variantId String
  unitPrice Decimal  @db.Decimal(12, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([companyId, variantId])
}

model QuantityBreak {
  id        String   @id @default(cuid())
  variantId String
  minQty    Int
  unitPrice Decimal  @db.Decimal(12, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
}

model Promotion {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      PromotionType
  value     Decimal       @db.Decimal(12, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Basket {
  id        String       @id @default(cuid())
  /// Company-owned trade baskets. Null for INTERNAL admin trade-test baskets.
  companyId String?
  /// Creator / owner. Required for admin test baskets (companyId null).
  userId    String?
  status    BasketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?        @relation("AdminTestBasketOwner", fields: [userId], references: [id], onDelete: Cascade)
  items   BasketItem[]

  @@index([companyId, status])
  @@index([userId, status])
}

model BasketItem {
  id        String   @id @default(cuid())
  basketId  String
  variantId String
  qty       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basket  Basket         @relation(fields: [basketId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([basketId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  companyId       String
  status          OrderStatus @default(DRAFT)
  /// Customer PO / reference (YOUR REFERENCE).
  poNumber        String?
  orderedByUserId String?
  onBehalfOfUserId String?
  currency        String      @default("GBP")
  /// Snapshot totals — historical, not recomputed from live prices
  subtotal        Decimal     @db.Decimal(12, 2)
  vatTotal        Decimal     @db.Decimal(12, 2)
  deliveryTotal   Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal     @db.Decimal(12, 2)
  /// Delivery destination snapshot at place time (never live Address.id alone).
  deliveryAddress Json?
  /// Optional billing/company address snapshot.
  billingAddress  Json?
  /// Ordering contact snapshot: { name, email, phone }.
  contactSnapshot Json?
  deliveryInstructions String?
  /// Company payment terms snapshotted at place (null if none configured).
  paymentTermsSnapshot String?
  /// Verified Autopart customer code only — never claimed-unverified application values.
  autopartCustomerCodeSnapshot String?
  autopartAccountLinked Boolean @default(false)
  salesRepIdSnapshot   String?
  salesRepCodeSnapshot String?
  salesRepNameSnapshot String?
  /// Restrained Phase 6B label — no shipping engine / APC.
  deliveryMethodLabel  String?
  /// Source basket converted by this order (audit link).
  basketId        String?
  /// Client/server idempotency key — unique per successful place.
  idempotencyKey  String?     @unique
  notes           String?
  /// Reserved for future Autopart order id / ERP ref — CSV export does not set this.
  externalRef     String?     @unique
  /// Autopart CSV export lifecycle (manual import handoff — not APC / not Autopart API).
  autopartExportStatus AutopartExportStatus @default(NOT_EXPORTED)
  autopartExportedAt   DateTime?
  autopartExportedByUserId String?
  autopartExportBatchId String?
  /// How many times a CSV was generated for this order (first export + re-exports).
  autopartExportCount  Int @default(0)
  /// When placed from an accepted quote — commercial prices come from the quote snapshot.
  sourceQuoteId       String?
  sourceQuoteNumber   String?
  placedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id])
  items        OrderItem[]
  invoices     Invoice[]
  reservations OrderStockReservation[]
  fulfilmentEvents OrderFulfilmentEvent[]
  autopartExportedBy User? @relation("OrderAutopartExporter", fields: [autopartExportedByUserId], references: [id], onDelete: SetNull)
  autopartExportBatch AutopartOrderExportBatch? @relation(fields: [autopartExportBatchId], references: [id], onDelete: SetNull)
  sourceQuote  Quote?                  @relation("OrdersFromQuote", fields: [sourceQuoteId], references: [id], onDelete: SetNull)

  @@index([companyId, placedAt])
  @@index([status])
  @@index([poNumber])
  @@index([autopartExportStatus])
  @@index([autopartExportBatchId])
  @@index([sourceQuoteId])
}

/// Authoritative fulfilment timeline for customer portal (never invent events).
model OrderFulfilmentEvent {
  id                  String                   @id @default(cuid())
  orderId             String
  kind                OrderFulfilmentEventKind
  occurredAt          DateTime                 @default(now())
  /// Customer-safe summary (no Autopart/MAM jargon).
  summary             String
  /// ORDER_PLACE | AUTOPART_EXPORT | AUTOPART_504C | MANUAL
  source              String
  invoiceId           String?
  /// True only when line-level quantities were known for this event.
  lineQuantitiesKnown Boolean                  @default(false)
  /// Explicit limitation when 504C/order-level evidence cannot identify SKU quantities.
  limitation          String?
  metadata            Json?
  createdAt           DateTime                 @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([orderId, occurredAt])
}

/// Durable metadata for an Autopart CSV download batch (no CSV body stored).
model AutopartOrderExportBatch {
  id              String   @id @default(cuid())
  /// Human reference e.g. APX-000001
  reference       String   @unique
  createdAt       DateTime @default(now())
  createdByUserId String
  orderCount      Int
  lineCount       Int
  filename        String
  /// Order ids included in this download (JSON string[]).
  orderIds        Json
  isReexport      Boolean  @default(false)

  createdBy User    @relation("AutopartExportBatchCreator", fields: [createdByUserId], references: [id])
  orders    Order[]

  @@index([createdAt])
  @@index([createdByUserId])
}

/// Race-safe Autopart export batch reference allocator (APX-000001…).
model AutopartExportBatchSequence {
  id        String @id @default("default")
  nextValue Int    @default(1)
}

/// AB-side stock hold created at placeOrder. Basket does NOT reserve.
model OrderStockReservation {
  id          String                 @id @default(cuid())
  orderId     String
  orderItemId String?
  variantId   String
  inventoryId String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  releasedAt  DateTime?
  consumedAt  DateTime?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId, status])
  @@index([inventoryId, status])
}

/// Durable transactional email outbox — never rolls back order creation on send failure.
model TransactionalEmail {
  id             String                    @id @default(cuid())
  purpose        TransactionalEmailPurpose
  status         TransactionalEmailStatus  @default(PENDING)
  toEmail        String
  subject        String
  textBody       String
  htmlBody       String?
  entityType     String
  entityId       String
  /// Unique per purpose+entity for initial send idempotency (e.g. "ORDER_RECEIVED:orderId")
  idempotencyKey String                    @unique
  attemptCount   Int                       @default(0)
  lastError      String?
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String?
  productId   String?
  sku         String
  name        String
  qty         Int
  /// Authoritative commercial unit price ex VAT (4dp) at place time.
  unitPrice   Decimal @db.Decimal(12, 4)
  /// Customer sell unit price ex VAT (2dp HALF-UP) used for line maths.
  customerUnitPrice Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  vatCode     String?
  /// Line net ex VAT (= customerUnitPrice × qty).
  lineTotal   Decimal @db.Decimal(12, 2)
  lineVat     Decimal @db.Decimal(12, 2) @default(0)
  lineGross   Decimal @db.Decimal(12, 2) @default(0)
  caseQty     Int?
  /// CASE | FINAL_PART_CASE at place time.
  orderingMode String?
  priceSource String?
  quantityBreakId String?
  promotionId String?
  /// Effective sellable units available when the order was placed (historical snapshot).
  availableQtyAtOrder Int?
  /// Units beyond availableQtyAtOrder at placement (historical snapshot). Never recompute from live stock.
  backorderQtyAtOrder Int @default(0)
  /// Cumulative units authoritatively despatched (line-level evidence only — never invent from stock/504C totals).
  despatchedQty Int @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([sku])
  @@index([backorderQtyAtOrder])
  @@index([despatchedQty])
}

/// Race-safe Automotive Brands order number allocator (AB-000001…).
model OrderNumberSequence {
  id        String @id @default("default")
  nextValue Int    @default(1)
}

/// Race-safe quote number allocator (QT-000001…).
model QuoteNumberSequence {
  id        String @id @default("default")
  nextValue Int    @default(1)
}

model Quote {
  id           String      @id @default(cuid())
  quoteNumber  String      @unique
  companyId    String
  status       QuoteStatus @default(DRAFT)
  currency     String      @default("GBP")
  /// Goods net ex VAT (snapshot).
  subtotal     Decimal     @db.Decimal(12, 2)
  deliveryTotal Decimal    @db.Decimal(12, 2) @default(0)
  vatTotal     Decimal     @db.Decimal(12, 2)
  grandTotal   Decimal     @db.Decimal(12, 2)
  /// Validity end date (date-only semantics — store UTC noon for the calendar day).
  expiresAt    DateTime?
  /// Legacy free-text notes — prefer customerNotes / internalNotes.
  notes        String?
  customerNotes String?
  internalNotes String?
  poNumber     String?
  contactId    String?
  contactSnapshot Json?
  deliveryAddressId String?
  deliveryAddress Json?
  salesRepIdSnapshot   String?
  salesRepCodeSnapshot String?
  salesRepNameSnapshot String?
  /// Historical prepared-by contact details (name/title/email/phone) for quote email/print.
  preparedBySnapshot   Json?
  paymentTermsSnapshot String?
  createdById  String?
  publicToken  String?     @unique
  sentAt       DateTime?
  sentById     String?
  firstViewedAt DateTime?
  acceptedAt   DateTime?
  acceptedByUserId String?
  acceptedByStaffId String?
  acceptanceNote String?
  declinedAt   DateTime?
  declineReason String?
  convertedAt  DateTime?
  convertedOrderId String? @unique
  deliveryOverridden Boolean @default(false)
  deliveryOverrideById String?
  revisionOfQuoteId String?
  /// Idempotency for customer/staff acceptance → order conversion.
  acceptIdempotencyKey String? @unique
  /// Optional link to CRM Opportunity (additive; quotes remain authoritative).
  opportunityId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  orders      Order[]      @relation("OrdersFromQuote")

  @@index([companyId, status])
  @@index([status, expiresAt])
  @@index([createdById])
  @@index([opportunityId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  variantId   String?
  productId   String?
  sku         String
  name        String
  qty         Int
  /// Quoted commercial unit price ex VAT (4dp) — may be overridden.
  unitPrice   Decimal @db.Decimal(12, 4)
  /// Normal resolved unit price before quote override (4dp).
  normalUnitPrice Decimal @db.Decimal(12, 4)
  /// Quoted customer sell unit (2dp HALF-UP).
  customerUnitPrice Decimal @db.Decimal(12, 2)
  /// Normal resolved customer sell unit before override (2dp).
  normalCustomerUnitPrice Decimal @db.Decimal(12, 2)
  priceOverride Boolean @default(false)
  priceOverrideById String?
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  vatCode     String?
  lineTotal   Decimal @db.Decimal(12, 2)
  lineVat     Decimal @db.Decimal(12, 2) @default(0)
  lineGross   Decimal @db.Decimal(12, 2) @default(0)
  caseQty     Int?
  orderingMode String?
  priceSource String?
  quantityBreakId String?
  promotionId String?
  sortOrder   Int     @default(0)

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
