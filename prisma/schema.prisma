model Task {
  id           String       @id @default(cuid())
  companyId    String?
  assigneeId   String?
  createdById  String?
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  /// Optional CRM task kind: CALL | EMAIL | MEETING | FOLLOW_UP | GENERAL
  taskType     String?
  dueAt        DateTime?
  completedAt  DateTime?
  /// Origin module when created from Sales Intelligence (or similar bridges).
  sourceModule String?
  /// Factual reason/classification at creation (e.g. STOPPED, RANGE_GAP).
  sourceReason String?
  /// SKU snapshot key for product-context follow-ups / open-duplicate checks.
  sourceSku    String?
  productId    String?
  /// Concise structured evidence snapshot (never full report dumps).
  sourceContext Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User?    @relation("TaskCreator", fields: [createdById], references: [id])
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([companyId, status])
  @@index([companyId, sourceModule, sourceReason, sourceSku, status])
  @@index([sourceModule, status])
  @@index([productId])
  @@index([dueAt, status])
  @@index([taskType, status])
}

model Note {
  id        String   @id @default(cuid())
  companyId String?
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  author  User?    @relation(fields: [authorId], references: [id])

  @@index([companyId, createdAt])
}

