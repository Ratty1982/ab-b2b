/// Legacy polymorphic attachment scaffold (company / application / product).
/// Product SDS and related catalogue files use ProductDocument instead.
model Document {
  id             String             @id @default(cuid())
  fileName       String
  contentType    String
  sizeBytes      Int?
  storageKey     String
  visibility     DocumentVisibility @default(INTERNAL)
  companyId      String?
  productId      String?
  applicationId  String?
  uploadedById   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company     Company?          @relation(fields: [companyId], references: [id])
  product     Product?          @relation(fields: [productId], references: [id])
  application TradeApplication? @relation(fields: [applicationId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([visibility])
}

/// Reusable product-level documents (Safety Data Sheets, TDS, etc.).
/// Stored in R2 (or Postgres bytes fallback). Product-owned by default.
model ProductDocument {
  id                 String                @id @default(cuid())
  productId          String
  /// Optional variant scope — normally null (one SDS covers all pack sizes).
  productVariantId   String?
  type               ProductDocumentType
  status             ProductDocumentStatus @default(CURRENT)
  title              String
  originalFilename   String
  storageKey         String
  storageProvider    String                @default("database")
  /// Local/database provider payload (null when stored in R2/S3).
  bytes              Bytes?
  contentType        String
  sizeBytes          Int
  checksumSha256     String
  revision           String?
  /// Optional document/revision calendar date (UTC noon).
  documentDate       DateTime?
  notes              String?
  sourceMetadata     Json?
  uploadedById       String?
  archivedAt         DateTime?
  archivedById       String?
  replacesDocumentId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, status])
  @@index([productId, status])
  @@index([checksumSha256])
  @@index([type, status])
  @@index([uploadedById])
}

/// Microsoft Graph connection for Power Maxed SDS SharePoint/OneDrive folder.
/// Client secret is write-only (AES encrypted or env-backed). Singleton row.
model SharePointSdsSettings {
  id                      String    @id @default("singleton")
  enabled                 Boolean   @default(false)
  sourceLabel             String    @default("Power Maxed SDS")
  folderDisplayName       String    @default("Power Maxed SDS 2025")
  /// Optional helper URL used once to resolve stable Graph IDs.
  folderUrlHint           String?
  tenantId                String?
  clientId                String?
  clientSecretEncrypted   String?
  /// OneDrive/SharePoint user whose drive holds the folder (UPN).
  userPrincipalName       String?
  driveId                 String?
  folderItemId            String?
  lastConnectionTestAt    DateTime?
  lastConnectionTestOk    Boolean?
  lastConnectionTestError String?
  lastScanAt              DateTime?
  lastScanError           String?
  lastScanFileCount       Int?
  updatedByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// Server-side SharePoint SDS scan preview (bytes stay off the browser).
model SharePointSdsScanSession {
  id              String   @id @default(cuid())
  status          String   @default("READY")
  createdByUserId String
  driveId         String
  folderItemId    String
  folderName      String?
  summaryJson     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  items SharePointSdsScanItem[]

  @@index([createdByUserId, createdAt])
  @@index([status])
}

model SharePointSdsScanItem {
  id                 String   @id @default(cuid())
  sessionId          String
  clientKey          String
  filename           String
  graphItemId        String?
  graphEtag          String?
  graphCtag          String?
  graphLastModified  DateTime?
  sizeBytes          Int      @default(0)
  checksumSha256     String   @default("")
  status             String
  message            String   @default("")
  productId          String?
  productName        String?
  sku                String?
  candidatesJson     Json?
  /// Existing ProductDocument id when ALREADY_ATTACHED / UPDATED_SOURCE / SOURCE_MISSING.
