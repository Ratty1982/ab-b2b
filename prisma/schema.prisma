// Automotive Brands — production foundation schema (Phase 0)
// PostgreSQL + Prisma. No seed business data in migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ActorType {
  INTERNAL
  TRADE
}

/// INTERNAL admin public-catalogue trade test pricing context.
/// NONE = ordering disabled; BASE_TRADE = ProductVariant.tradePrice;
/// PRICE_LIST = selected PriceList (tradeTestPriceListId).
enum TradeTestPricingMode {
  NONE
  BASE_TRADE
  PRICE_LIST
}

enum CompanyStatus {
  PROSPECT
  /// Product language: Pending (trade application / onboarding)
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  SUSPENDED
  CLOSED
}

enum TaxStatus {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUTSIDE_SCOPE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Distinguishes company portal invites from admin-created staff invitations.
enum InvitationKind {
  COMPANY_USER
  STAFF_USER
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsSectionType {
  HERO
  BRAND_LOGO_STRIP
  FEATURED_BRANDS
  CATEGORY_GRID
  FEATURED_PRODUCTS
  NEW_PRODUCTS
  POPULAR_PRODUCTS
  RESOURCES
  NEWS
  TEXT_IMAGE
  IMAGE_TEXT
  BENEFITS_GRID
  TRADE_CTA
  BANNER
  RICH_TEXT
  SPACER
  /// Homepage / marketing photographic motorsport feature band.
  MOTORSPORT_FEATURE
  /// Responsive media gallery (motorsport page and reusable CMS).
  MEDIA_GALLERY
}

/// Company-scoped trade access levels (distinct from system Role).
/// TRADE_ADMIN is the Phase 0 enum key for TRADE_ACCOUNT_ADMIN in product language.
enum CompanyUserRole {
  TRADE_ADMIN
  TRADE_BUYER
  TRADE_ACCOUNTS
  TRADE_READ_ONLY
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AddressType {
  TRADING
  DELIVERY
  BILLING
  REGISTERED
}

enum TradeApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum StockStatus {
  IN_STOCK
  LOW
  BACKORDER
  OUT_OF_STOCK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductImportStatus {
  UPLOADED
  READY
  APPLIED
  FAILED
}

enum StockSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum StockIssueKind {
  UNMATCHED
  INVALID
  DUPLICATE
  PARSE
  CONFLICT
}

enum BasketStatus {
  OPEN
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PICKING
  DISPATCHED
  DELIVERED
  CANCELLED
  ON_HOLD
}

/// Operational Autopart CSV handoff only — not fulfilment / despatch.
enum AutopartExportStatus {
  NOT_EXPORTED
  EXPORTED
}

/// Automotive Brands order-side stock hold (not an Autopart ERP reservation).
enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum TransactionalEmailPurpose {
  ORDER_RECEIVED
  ORDER_RECEIVED_INTERNAL
  ORDER_DESPATCHED
  TRADE_APPLICATION_RECEIVED
  TRADE_APPLICATION_INTERNAL_NOTIFICATION
  TRADE_APPLICATION_MORE_INFO
  TRADE_APPLICATION_APPROVED
  TRADE_APPLICATION_REJECTED
  TRADE_ACCOUNT_ACTIVATED
  COMPANY_USER_INVITED
  USER_INVITATION
  PASSWORD_RESET
  MOTORSPORT_PARTNERSHIP_INTERNAL
  EMAIL_TEST
}

/// SMTP security mode for outbound transactional email (Admin → Settings → Email).
enum SmtpSecurity {
  SSL_TLS
  STARTTLS
  NONE
}

enum TransactionalEmailStatus {
  PENDING
  SENT
  FAILED
  DEFERRED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  VOID
}

/// Autopart 504C document classification.
enum AutopartDocumentKind {
  INVOICE
  CREDIT
  UNKNOWN
}

enum Autopart504cImportStatus {
  SUCCESS
  PARTIAL
  FAILED
  DRY_RUN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  NEW_LEAD
  QUALIFIED
  CONTACTED
  MEETING
  QUOTE_REQUIRED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  NOTE
  TASK
  FOLLOW_UP
  SYSTEM
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum DocumentVisibility {
  PUBLIC
  TRADE
  INTERNAL
}

enum PromotionType {
  PERCENT
  FIXED
  QUANTITY_DEAL
}

// ─── Identity & access ───────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  /// Legacy / unused by Better Auth credential accounts (password lives on AuthAccount)
  passwordHash String?
  status       UserStatus @default(INVITED)
  actorType    ActorType  @default(TRADE)

  /// Better Auth core field (boolean). emailVerifiedAt retained for richer audit timestamps.
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  image           String?

  /// MFA-ready fields — enforcement planned for privileged roles (Phase 1+ docs)
  mfaEnabled     Boolean @default(false)
  mfaSecretEnc   String?
  mfaRecoveryEnc String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// INTERNAL only: admin public-catalogue trade test pricing mode.
  /// Never used for TRADE customers. Never invents a Company.
  tradeTestPricingMode TradeTestPricingMode @default(NONE)
  /// Required when tradeTestPricingMode = PRICE_LIST; otherwise null.
  tradeTestPriceListId String?
  tradeTestPriceList   PriceList? @relation("UserTradeTestPriceList", fields: [tradeTestPriceListId], references: [id], onDelete: SetNull)

  companyUsers       CompanyUser[]
  userRoles          UserRole[]
  salesRep           SalesRep?
  invitations        UserInvitation[]  @relation("InvitationUser")
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  activities         Activity[]
  notes              Note[]
  auditEvents        AuditEvent[]      @relation("AuditActor")
  auditEventsAsTarget AuditEvent[]     @relation("AuditTarget")
  tradeAppsReviewed  TradeApplication[] @relation("ApplicationReviewer")
  autopartCodesVerified Company[]       @relation("AutopartCodeVerifier")
  autopartOrdersExported Order[]        @relation("OrderAutopartExporter")
  autopartExportBatches  AutopartOrderExportBatch[] @relation("AutopartExportBatchCreator")
  autopart504cImportRuns Autopart504cImportRun[] @relation("Autopart504cImportCreator")
  ownedLeads         Lead[]
  ownedOpportunities Opportunity[]
  sessions           AuthSession[]
  accounts           AuthAccount[]
  actingContexts     ActingContext[]   @relation("ActingActor")
  productImports     ProductImportJob[]
  testBaskets        Basket[]          @relation("AdminTestBasketOwner")

  @@index([actorType, status])
  @@index([tradeTestPriceListId])
}

/// Better Auth–compatible session table shape (wired in Phase 1)
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth–compatible account / provider linkage
model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth verification / password-reset tokens (never log `value`)
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Sales order-for-customer context (actor remains themselves — not classic impersonation)
model ActingContext {
  id                 String    @id @default(cuid())
  actorUserId        String
  onBehalfOfCompanyId String
  startedAt          DateTime  @default(now())
  endsAt             DateTime?
  endedAt            DateTime?
  reason             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actor            User    @relation("ActingActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  onBehalfOfCompany Company @relation(fields: [onBehalfOfCompanyId], references: [id], onDelete: Cascade)

  @@index([actorUserId, endedAt])
  @@index([onBehalfOfCompanyId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─── Companies & people ──────────────────────────────────────────────────────

model Company {
  id             String        @id @default(cuid())
  accountNumber  String?       @unique
  name           String
  tradingName    String?
  companyNumber  String?
  vatNumber      String?
  status         CompanyStatus @default(PROSPECT)
  taxStatus      TaxStatus     @default(STANDARD)
  paymentTerms   String?
  creditLimit    Decimal?      @db.Decimal(12, 2)
  currency       String        @default("GBP")
  priceListId    String?
  /// Generic external ERP reference (legacy / non-Autopart). Prefer autopartCustomerCode for Autopart.
  externalRef    String?       @unique
  /// Verified Autopart customer/account code for future order handoff. Never a login secret.
  autopartCustomerCode            String?   @unique
  autopartCustomerCodeVerifiedAt  DateTime?
  autopartCustomerCodeVerifiedById String?
  website        String?
  phone          String?
  primaryEmail   String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  priceList      PriceList?    @relation(fields: [priceListId], references: [id])
  autopartCustomerCodeVerifiedBy User? @relation("AutopartCodeVerifier", fields: [autopartCustomerCodeVerifiedById], references: [id], onDelete: SetNull)
  users          CompanyUser[]
  contacts       Contact[]
  addresses      Address[]
  assignments    CompanyAssignment[]
  applications   TradeApplication[]
  invitations    UserInvitation[]
  customerPrices CustomerPrice[]
  baskets        Basket[]
  orders         Order[]
  quotes         Quote[]
  invoices       Invoice[]
  leads          Lead[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  notesList       Note[]
  documents       Document[]
  auditEvents     AuditEvent[]
  actingContexts  ActingContext[]

  @@index([status])
  @@index([name])
  @@index([primaryEmail])
  @@index([autopartCustomerCode])
}

model CompanyUser {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyUserRole   @default(TRADE_BUYER)
  status    CompanyUserStatus @default(INVITED)
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Contact {
  id           String   @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  mobile       String?
  jobTitle     String?
  isPrimary    Boolean  @default(false)
  isPurchasing Boolean  @default(false)
  isAccounts   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model Address {
  id               String      @id @default(cuid())
  companyId        String
  type             AddressType @default(DELIVERY)
  label            String?
  line1            String
  line2            String?
  town             String
  county           String?
  postcode         String
  country          String      @default("GB")
  /// Legacy generic default — prefer isDefaultBilling / isDefaultDelivery
  isDefault        Boolean     @default(false)
  isDefaultBilling Boolean     @default(false)
  isDefaultDelivery Boolean    @default(false)
  contactName      String?
  contactPhone     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
  @@index([companyId, isDefaultBilling])
  @@index([companyId, isDefaultDelivery])
}

/// Portal / company-user invitation foundation (email delivery is optional later).
model UserInvitation {
  id              String            @id @default(cuid())
  kind            InvitationKind    @default(COMPANY_USER)
  /// Required for COMPANY_USER invites; null for STAFF_USER.
  companyId       String?
  /// Pre-created User for STAFF_USER (and optional for company invites).
  userId          String?
  email           String
  /// Company portal role — set for COMPANY_USER only.
  role            CompanyUserRole?
  /// System role key snapshot for STAFF_USER invites (display only; UserRole is authoritative).
  systemRoleKey   String?
  status          InvitationStatus  @default(PENDING)
  /// SHA-256 hex of the opaque invite token (never store raw token)
  tokenHash       String            @unique
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  /// When true, invite was created but outbound email was not sent (no provider)
  emailDeferred   Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([userId, status])
  @@index([email])
  @@index([expiresAt])
  @@index([kind, status])
}

model SalesRep {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String?  @unique
  region    String?
  /// Optional manager SalesRep for team-scoped access (SALES_MANAGER)
  managerId String?
  targetMtd Decimal? @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager      SalesRep?           @relation("SalesRepTeam", fields: [managerId], references: [id])
  teamMembers  SalesRep[]          @relation("SalesRepTeam")
  assignments  CompanyAssignment[]
  applications TradeApplication[]
  publicTeamProfile TeamMember?

  @@index([managerId])
}

model CompanyAssignment {
  id         String   @id @default(cuid())
  companyId  String
  salesRepId String
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@unique([companyId, salesRepId])
  @@index([salesRepId])
}

model TradeApplication {
  id               String                 @id @default(cuid())
  reference        String                 @unique
  status           TradeApplicationStatus @default(SUBMITTED)
  companyId        String?
  companyName      String
  tradingName      String?
  companyNumber    String?
  vatNumber        String?
  businessType     String?
  website          String?
  tradingAddress   Json?
  deliveryAddress  Json?
  primaryContact   Json?
  accountsContact  Json?
  estimatedSpend   String?
  /// How the applicant heard about Automotive Brands (optional marketing insight).
  howHeardAboutUs  String?
  brandsInterest   String[]
  notes            String?
  reviewNotes      String?
  /// Customer-facing message for MORE_INFO_REQUIRED / optional rejection notice.
  customerMessage  String?
  /// yes | no | not_sure — claim about an existing Autopart/trade account.
  existingAccountClaim String?
  /// Applicant-claimed Autopart/account number — evidence only, never a verified ERP link.
  claimedAutopartCustomerCode String?
  /// When the applicant accepted privacy/terms acknowledgement on submit.
  consentAcceptedAt DateTime?
  assignedRepId    String?
  reviewedById     String?
  submittedAt      DateTime               @default(now())
  decidedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company    Company?  @relation(fields: [companyId], references: [id])
  assignedRep SalesRep? @relation(fields: [assignedRepId], references: [id])
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  Document[]

  @@index([status, submittedAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  logoMediaId String?
  logoAlt     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  logoMedia CmsMedia? @relation("BrandLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@index([logoMediaId])
  @@index([isActive, sortOrder])
}

model Category {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  parentId     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  imageMediaId String?
  imageAlt     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]
  imageMedia CmsMedia?  @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([imageMediaId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  brandId          String
  categoryId       String?
  description      String?
  shortDescription String?
  /// Spec rows: [{ name, value }]
  specifications   Json?
  isActive         Boolean       @default(true)
  status           ProductStatus @default(ACTIVE)
  isTradeVisible   Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  isNew            Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand     Brand            @relation(fields: [brandId], references: [id])
  category  Category?        @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  documents Document[]
  media     ProductMedia[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status, isTradeVisible])
  @@index([updatedAt])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  barcode        String?
  mpn            String?
  name           String?
  packQty        Int      @default(1)
  caseQty        Int?
  minOrderQty    Int      @default(1)
  orderIncrement Int      @default(1)
  unit           String   @default("EA")
  weightKg       Decimal? @db.Decimal(10, 3)
  lengthMm       Decimal? @db.Decimal(10, 2)
  widthMm        Decimal? @db.Decimal(10, 2)
  heightMm       Decimal? @db.Decimal(10, 2)
  /// Base catalogue trade price (Phase 4 pricing engine replaces customer-facing calculation)
  tradePrice     Decimal? @db.Decimal(12, 4)
  rrp            Decimal? @db.Decimal(12, 2)
  vatCode        String   @default("STANDARD")
  /// External ERP / Autopart SKU
  externalRef    String?  @unique
  isDefault      Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  priceListItems PriceListItem[]
  customerPrices CustomerPrice[]
  quantityBreaks QuantityBreak[]
  basketItems    BasketItem[]
  orderItems     OrderItem[]
  quoteItems       QuoteItem[]
  stockSyncChanges StockSyncChange[]

  @@index([productId])
  @@index([barcode])
  @@index([mpn])
}

/// Product ↔ CMS media. Detach does not delete CmsMedia.
model ProductMedia {
  id         String   @id @default(cuid())
  productId  String
  mediaId    String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  altText    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   CmsMedia @relation("ProductMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}

model ProductImportJob {
  id                String              @id @default(cuid())
  filename          String
  uploadedById      String
  status            ProductImportStatus @default(UPLOADED)
  rowCount          Int                 @default(0)
  createdCount      Int                 @default(0)
  updatedCount      Int                 @default(0)
  skippedCount      Int                 @default(0)
  errorCount        Int                 @default(0)
  warningCount      Int                 @default(0)
  /// Column header → canonical field key
  mapping           Json
  unknownBrands     Json?
  unknownCategories Json?
  /// Parsed rows + preview summary (not the raw CSV)
  preview           Json?
  result            Json?
  errorReport       String?
  sourceHash        String?
  /// Original file text for remapping; kept off the preview JSON blob
  sourceCsv         String? @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  appliedAt         DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([uploadedById])
  @@index([status])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
}

model Inventory {
  id               String      @id @default(cuid())
  variantId        String
  warehouseId      String
  /// Latest Autopart Avail (authoritative on-hand from 231PO3NEW). Sync updates this only.
  qtyOnHand        Int         @default(0)
  /// Sum of ACTIVE Automotive Brands OrderStockReservation quantities.
  /// Sync must NEVER reset qtyReserved — effective sellable = max(0, qtyOnHand - qtyReserved).
  qtyReserved      Int         @default(0)
  status           StockStatus @default(IN_STOCK)
  /// When true, UI may show status but exact qty is trade-only policy elsewhere
  updatedAt        DateTime    @updatedAt
  /// Optional Autopart sync stamp
  externalSyncedAt DateTime?
  /// Raw Avail from 231PO3NEW for diagnostics (may be negative); qtyOnHand is the clamped Avail.
  sourceAvailRaw   String?

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reservations OrderStockReservation[]

  @@unique([variantId, warehouseId])
  @@index([status])
}

model StockSyncRun {
  id             String          @id @default(cuid())
  source         String
  mode           String
  status         StockSyncStatus @default(RUNNING)
  trigger        String
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  rowsRead       Int             @default(0)
  matched        Int             @default(0)
  updated        Int             @default(0)
  unchanged      Int             @default(0)
  unmatched      Int             @default(0)
  invalid        Int             @default(0)
  duplicates     Int             @default(0)
  absentFromFeed Int             @default(0)
  errorSummary   String?
  actorUserId    String?
  durationMs     Int?
  createdAt      DateTime        @default(now())

  issues  StockSyncIssue[]
  changes StockSyncChange[]

  @@index([startedAt])
  @@index([status, startedAt])
}

/// Live Autopart quantity change (old → new). Unchanged SKUs and unmatched
/// Autopart SKUs are not stored here. Dry-run never writes this table.
model StockSyncChange {
  id                   String   @id @default(cuid())
  runId                String
  variantId            String?
  productId            String?
  skuSnapshot          String
  productNameSnapshot  String
  variantLabelSnapshot String?
  previousQty          Int
  newQty               Int
  previousAvailability String
  newAvailability      String
  createdAt            DateTime @default(now())

  run     StockSyncRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([variantId])
  @@index([createdAt])
}

model StockSyncIssue {
  id          String         @id @default(cuid())
  runId       String
  kind        StockIssueKind
  sku         String?
  description String?
  availRaw    String?
  message     String
  line        Int?
  createdAt   DateTime       @default(now())

  run StockSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
}

model StockFeedUnmatched {
  sku              String   @id
  description      String?
  lastAvailRaw     String?
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  lastRunId        String
  occurrenceCount  Int      @default(1)
  reason           String

  @@index([lastSeenAt])
}

/// Single-row mutex so Autopart imports cannot overlap (Prisma-safe; not Redis).
model StockSyncMutex {
  id       String    @id
  holder   String?
  lockedAt DateTime?
}

/// In-application Autopart scheduler health (tick timestamps; not secrets).
model StockScheduleState {
  id         String    @id @default("singleton")
  startedAt  DateTime?
  lastTickAt DateTime?
  lastDueKey String?
}

/// One row per Autopart business window (Europe/London date + 09/12/15/18).
model StockScheduleWindow {
  key           String    @id
  businessDate  String
  hour          Int
  status        String
  lastAttemptAt DateTime?
  completedAt   DateTime?
  lastRunId     String?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessDate])
  @@index([status])
}

/// Outbound transactional email settings (Admin → Settings → Email).
/// SMTP password is write-only: stored AES-256-GCM encrypted; never returned to clients.
model EmailSettings {
  id                           String       @id @default("singleton")
  enabled                      Boolean      @default(false)
  smtpHost                     String?
  smtpPort                     Int          @default(465)
  smtpSecurity                 SmtpSecurity @default(SSL_TLS)
  smtpUsername                 String?
  smtpPasswordEncrypted        String?
  fromName                     String?
  fromEmail                    String?
  replyToName                  String?
  replyToEmail                 String?
  /// JSON string array of email addresses for new trade application alerts.
  tradeApplicationRecipients   Json         @default("[]")
  /// JSON string array of email addresses for new B2B order alerts.
  orderNotificationRecipients  Json         @default("[]")
  /// JSON string array for motorsport partnership enquiry alerts.
  motorsportEnquiryRecipients  Json         @default("[]")
  lastConnectionTestAt         DateTime?
  lastConnectionTestOk         Boolean?
  lastConnectionTestError      String?
  lastTestEmailAt              DateTime?
  lastTestEmailOk              Boolean?
  lastTestEmailError           String?
  updatedByUserId              String?
  updatedAt                    DateTime     @updatedAt
  createdAt                    DateTime     @default(now())
}

/// Operational IMAP settings. Password is write-only (encrypted or env-backed).
model AutopartImapSettings {
  id                         String    @id @default("singleton")
  enabled                    Boolean   @default(false)
  inboundEmailAddress        String    @default("")
  imapHost                   String?
  imapPort                   Int       @default(993)
  imapSecure                 Boolean   @default(true)
  imapUsername               String?
  imapPasswordEncrypted      String?
  mailbox                    String    @default("INBOX")
  allowedSenderEmails        String    @default("")
  attachmentFilenamePattern  String    @default("231PO3NEW*.txt")
  pollIntervalMinutes        Int       @default(15)
  lookbackDays               Int       @default(14)
  maxMessages                Int       @default(100)
  autoArchiveProcessedEmails Boolean   @default(false)
  lastPollAt                 DateTime?
  lastPollError              String?
  lastEmailFrom              String?
  lastEmailSubject           String?
  lastEmailUid               String?
  lastAttachmentFilename     String?
  lastEmailReceivedAt        DateTime?
  updatedAt                  DateTime  @updatedAt
}

/// Processed IMAP receipts. Identity is UID + Message-ID, never Message-ID alone.
model StockEmailReceipt {
  id              String   @id @default(cuid())
  receiptKey      String   @unique
  emailUid        String
  emailMessageId  String?
  fromAddress     String
  subject         String
  receivedAt      DateTime
  attachmentFilename String?
  consumed        Boolean  @default(false)
  runId           String?
  createdAt       DateTime @default(now())

  @@index([emailUid])
  @@index([emailMessageId])
  @@index([consumed])
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PriceList {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  currency    String   @default("GBP")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          PriceListItem[]
  companies      Company[]
  tradeTestUsers User[]          @relation("UserTradeTestPriceList")
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  variantId   String
  unitPrice   Decimal  @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
}

model CustomerPrice {
  id        String   @id @default(cuid())
  companyId String
  variantId String
  unitPrice Decimal  @db.Decimal(12, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([companyId, variantId])
}

model QuantityBreak {
  id        String   @id @default(cuid())
  variantId String
  minQty    Int
  unitPrice Decimal  @db.Decimal(12, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
}

model Promotion {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      PromotionType
  value     Decimal       @db.Decimal(12, 4)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Basket {
  id        String       @id @default(cuid())
  /// Company-owned trade baskets. Null for INTERNAL admin trade-test baskets.
  companyId String?
  /// Creator / owner. Required for admin test baskets (companyId null).
  userId    String?
  status    BasketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?        @relation("AdminTestBasketOwner", fields: [userId], references: [id], onDelete: Cascade)
  items   BasketItem[]

  @@index([companyId, status])
  @@index([userId, status])
}

model BasketItem {
  id        String   @id @default(cuid())
  basketId  String
  variantId String
  qty       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basket  Basket         @relation(fields: [basketId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([basketId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  companyId       String
  status          OrderStatus @default(DRAFT)
  /// Customer PO / reference (YOUR REFERENCE).
  poNumber        String?
  orderedByUserId String?
  onBehalfOfUserId String?
  currency        String      @default("GBP")
  /// Snapshot totals — historical, not recomputed from live prices
  subtotal        Decimal     @db.Decimal(12, 2)
  vatTotal        Decimal     @db.Decimal(12, 2)
  deliveryTotal   Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal     @db.Decimal(12, 2)
  /// Delivery destination snapshot at place time (never live Address.id alone).
  deliveryAddress Json?
  /// Optional billing/company address snapshot.
  billingAddress  Json?
  /// Ordering contact snapshot: { name, email, phone }.
  contactSnapshot Json?
  deliveryInstructions String?
  /// Company payment terms snapshotted at place (null if none configured).
  paymentTermsSnapshot String?
  /// Verified Autopart customer code only — never claimed-unverified application values.
  autopartCustomerCodeSnapshot String?
  autopartAccountLinked Boolean @default(false)
  salesRepIdSnapshot   String?
  salesRepCodeSnapshot String?
  salesRepNameSnapshot String?
  /// Restrained Phase 6B label — no shipping engine / APC.
  deliveryMethodLabel  String?
  /// Source basket converted by this order (audit link).
  basketId        String?
  /// Client/server idempotency key — unique per successful place.
  idempotencyKey  String?     @unique
  notes           String?
  /// Reserved for future Autopart order id / ERP ref — CSV export does not set this.
  externalRef     String?     @unique
  /// Autopart CSV export lifecycle (manual import handoff — not APC / not Autopart API).
  autopartExportStatus AutopartExportStatus @default(NOT_EXPORTED)
  autopartExportedAt   DateTime?
  autopartExportedByUserId String?
  autopartExportBatchId String?
  /// How many times a CSV was generated for this order (first export + re-exports).
  autopartExportCount  Int @default(0)
  placedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id])
  items        OrderItem[]
  invoices     Invoice[]
  reservations OrderStockReservation[]
  autopartExportedBy User? @relation("OrderAutopartExporter", fields: [autopartExportedByUserId], references: [id], onDelete: SetNull)
  autopartExportBatch AutopartOrderExportBatch? @relation(fields: [autopartExportBatchId], references: [id], onDelete: SetNull)

  @@index([companyId, placedAt])
  @@index([status])
  @@index([poNumber])
  @@index([autopartExportStatus])
  @@index([autopartExportBatchId])
}

/// Durable metadata for an Autopart CSV download batch (no CSV body stored).
model AutopartOrderExportBatch {
  id              String   @id @default(cuid())
  /// Human reference e.g. APX-000001
  reference       String   @unique
  createdAt       DateTime @default(now())
  createdByUserId String
  orderCount      Int
  lineCount       Int
  filename        String
  /// Order ids included in this download (JSON string[]).
  orderIds        Json
  isReexport      Boolean  @default(false)

  createdBy User    @relation("AutopartExportBatchCreator", fields: [createdByUserId], references: [id])
  orders    Order[]

  @@index([createdAt])
  @@index([createdByUserId])
}

/// Race-safe Autopart export batch reference allocator (APX-000001…).
model AutopartExportBatchSequence {
  id        String @id @default("default")
  nextValue Int    @default(1)
}

/// AB-side stock hold created at placeOrder. Basket does NOT reserve.
model OrderStockReservation {
  id          String                 @id @default(cuid())
  orderId     String
  orderItemId String?
  variantId   String
  inventoryId String
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  releasedAt  DateTime?
  consumedAt  DateTime?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId, status])
  @@index([inventoryId, status])
}

/// Durable transactional email outbox — never rolls back order creation on send failure.
model TransactionalEmail {
  id             String                    @id @default(cuid())
  purpose        TransactionalEmailPurpose
  status         TransactionalEmailStatus  @default(PENDING)
  toEmail        String
  subject        String
  textBody       String
  htmlBody       String?
  entityType     String
  entityId       String
  /// Unique per purpose+entity for initial send idempotency (e.g. "ORDER_RECEIVED:orderId")
  idempotencyKey String                    @unique
  attemptCount   Int                       @default(0)
  lastError      String?
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String?
  productId   String?
  sku         String
  name        String
  qty         Int
  /// Authoritative commercial unit price ex VAT (4dp) at place time.
  unitPrice   Decimal @db.Decimal(12, 4)
  /// Customer sell unit price ex VAT (2dp HALF-UP) used for line maths.
  customerUnitPrice Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  vatCode     String?
  /// Line net ex VAT (= customerUnitPrice × qty).
  lineTotal   Decimal @db.Decimal(12, 2)
  lineVat     Decimal @db.Decimal(12, 2) @default(0)
  lineGross   Decimal @db.Decimal(12, 2) @default(0)
  caseQty     Int?
  /// CASE | FINAL_PART_CASE at place time.
  orderingMode String?
  priceSource String?
  quantityBreakId String?
  promotionId String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([sku])
}

/// Race-safe Automotive Brands order number allocator (AB-000001…).
model OrderNumberSequence {
  id        String @id @default("default")
  nextValue Int    @default(1)
}

model Quote {
  id           String      @id @default(cuid())
  quoteNumber  String      @unique
  companyId    String
  status       QuoteStatus @default(DRAFT)
  currency     String      @default("GBP")
  subtotal     Decimal     @db.Decimal(12, 2)
  vatTotal     Decimal     @db.Decimal(12, 2)
  grandTotal   Decimal     @db.Decimal(12, 2)
  expiresAt    DateTime?
  notes        String?
  createdById  String?
  publicToken  String?     @unique
  sentAt       DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company Company     @relation(fields: [companyId], references: [id])
  items   QuoteItem[]

  @@index([companyId, status])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  variantId   String?
  sku         String
  name        String
  qty         Int
  unitPrice   Decimal @db.Decimal(12, 4)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quoteId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  companyId     String
  orderId       String?
  status        InvoiceStatus @default(ISSUED)
  currency      String        @default("GBP")
  subtotal      Decimal       @db.Decimal(12, 2)
  vatTotal      Decimal       @db.Decimal(12, 2)
  grandTotal    Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime?
  dueAt         DateTime?
  /// Autopart document number (or other accounts package reference). Unique when set.
  externalRef   String?       @unique
  /// Autopart 504C classification when sourced from invoice feed.
  autopartDocumentKind AutopartDocumentKind?
  autopartAccountCode String?
  autopartCustomerOrderNumber String?
  autopartDocumentAt DateTime?
  autopartInitials String?
  autopartImportRunId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  autopartImportRun Autopart504cImportRun? @relation(fields: [autopartImportRunId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([orderId])
  @@index([autopartCustomerOrderNumber])
  @@index([autopartImportRunId])
}

/// 504C invoice/despatch feed settings — automatic polling defaults OFF.
model Autopart504cFeedSettings {
  id                 String   @id @default("default")
  /// When false (default), scheduler and live Poll Now must not reconcile mailbox files.
  enabled            Boolean  @default(false)
  /// Explicit admin mark that Autopart has configured the report email.
  configured         Boolean  @default(false)
  /// Working-day hours Europe/London — default [13, 16].
  scheduleHoursJson  String   @default("[13,16]")
  workingDaysOnly    Boolean  @default(true)
  allowedSender      String?
  subjectContains    String?  @default("504C")
  filenamePattern    String   @default("*504C*")
  /// Optional dedicated IMAP override; empty = reuse stock Autopart IMAP when enabled later.
  imapHost           String?
  imapPort           Int?
  imapUser           String?
  imapPasswordEnc    String?
  imapSecure         Boolean  @default(true)
  imapMailbox        String?  @default("INBOX")
  lastPolledAt       DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?
}

model Autopart504cImportRun {
  id              String                 @id @default(cuid())
  status          Autopart504cImportStatus
  isDryRun        Boolean                @default(false)
  startedAt       DateTime               @default(now())
  finishedAt      DateTime?
  source          String
  filename        String?
  messageId       String?
  fileHash        String?
  rowsRead        Int                    @default(0)
  abReferencesFound Int                  @default(0)
  ordersMatched   Int                    @default(0)
  newInvoices     Int                    @default(0)
  duplicates      Int                    @default(0)
  credits         Int                    @default(0)
  unmatchedAbRefs Int                    @default(0)
  invalidRows     Int                    @default(0)
  nonAbRows       Int                    @default(0)
  ordersDespatched Int                   @default(0)
  emailsQueued    Int                    @default(0)
  emailsSent      Int                    @default(0)
  emailsFailed    Int                    @default(0)
  diagnostics     Json?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  createdBy User? @relation("Autopart504cImportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([startedAt])
  @@index([status])
  @@index([fileHash])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id          String     @id @default(cuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  status      LeadStatus @default(NEW)
  source      String?
  ownerId     String?
  companyId   String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner   User?    @relation(fields: [ownerId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([status])
  @@index([ownerId])
}

model Opportunity {
  id          String           @id @default(cuid())
  companyId   String
  title       String
  stage       OpportunityStage @default(NEW_LEAD)
  value       Decimal?         @db.Decimal(12, 2)
  probability Int?
  ownerId     String?
  expectedClose DateTime?
  lostReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  owner   User?   @relation(fields: [ownerId], references: [id])

  @@index([companyId, stage])
  @@index([ownerId])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String?
  userId     String?
  type       ActivityType
  subject    String?
  body       String?
  occurredAt DateTime     @default(now())
  metadata   Json?
  createdAt  DateTime     @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, occurredAt])
  @@index([userId, occurredAt])
}

model Task {
  id           String       @id @default(cuid())
  companyId    String?
  assigneeId   String?
  createdById  String?
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User?    @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, status])
  @@index([companyId, status])
}

model Note {
  id        String   @id @default(cuid())
  companyId String?
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  author  User?    @relation(fields: [authorId], references: [id])

  @@index([companyId, createdAt])
}

// ─── Documents & audit ───────────────────────────────────────────────────────

model Document {
  id             String             @id @default(cuid())
  fileName       String
  contentType    String
  sizeBytes      Int?
  storageKey     String
  visibility     DocumentVisibility @default(INTERNAL)
  companyId      String?
  productId      String?
  applicationId  String?
  uploadedById   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company     Company?          @relation(fields: [companyId], references: [id])
  product     Product?          @relation(fields: [productId], references: [id])
  application TradeApplication? @relation(fields: [applicationId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([visibility])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  companyId    String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  /// SetNull so disposable users can be hard-deleted without destroying audit rows.
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser  User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

// ─── CMS / page builder foundation ───────────────────────────────────────────

model CmsPage {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  seoTitle        String?
  metaDescription String?
  status          CmsPageStatus @default(DRAFT)
  draftVersionId  String?       @unique
  publishedVersionId String?    @unique
  publishedAt     DateTime?
  ogImageMediaId  String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  versions  CmsPageVersion[]
  publishEvents CmsPublishEvent[]
  draftVersion     CmsPageVersion? @relation("CmsPageDraft", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion CmsPageVersion? @relation("CmsPagePublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@index([status])
}

model CmsPageVersion {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  label       String?
  /// Snapshot of page SEO fields at this version
  seoTitle    String?
  metaDescription String?
  createdById String?
  createdAt   DateTime @default(now())

  page     CmsPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sections CmsSection[]
  draftFor     CmsPage? @relation("CmsPageDraft")
  publishedFor CmsPage? @relation("CmsPagePublished")
  publishEvents CmsPublishEvent[]

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model CmsSection {
  id        String         @id @default(cuid())
  versionId String
  type      CmsSectionType
  /// Validated JSON config — never executable code
  config    Json
  sortOrder Int            @default(0)
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  version CmsPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, sortOrder])
}

model CmsMedia {
  id           String   @id @default(cuid())
  filename     String
  contentType  String
  sizeBytes    Int?
  width        Int?
  height       Int?
  altText      String?
  /// Object-storage key or abstract URI — not a local filesystem path contract
  storageKey   String
  storageProvider String @default("local")
  /// Image bytes for the local/database provider (survives Coolify without S3)
  bytes        Bytes?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandLogos    Brand[]        @relation("BrandLogo")
  categoryImages Category[]    @relation("CategoryImage")
  productMedia  ProductMedia[] @relation("ProductMedia")
  teamPhotos    TeamMember[]   @relation("TeamMemberPhoto")

  @@index([contentType])
  @@index([uploadedById])
}

model TeamDepartment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  /// When false, department and its members are omitted from public pages.
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]

  @@index([sortOrder])
  @@index([isPublic])
}

model TeamMember {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  jobTitle      String?
  bio           String?
  /// Public contact email only — never copied from User automatically.
  email         String?
  /// Public telephone only — never copied from User automatically.
  phone         String?
  linkedInUrl   String?
  sortOrder     Int      @default(0)
  /// Defaults hidden until staff explicitly publish.
  isPublic      Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  /// When false, email/phone/LinkedIn must not appear in public HTML.
  isContactable Boolean  @default(false)
  departmentId  String?
  photoMediaId  String?
  photoAlt      String?
  photoFocalX   Int      @default(50)
  photoFocalY   Int      @default(50)
  /// Optional link to CRM SalesRep for future Account Manager presentation.
  salesRepId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  photoMedia CmsMedia?       @relation("TeamMemberPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  salesRep   SalesRep?       @relation(fields: [salesRepId], references: [id], onDelete: SetNull)

  @@index([departmentId, sortOrder])
  @@index([isPublic, isFeatured])
  @@index([sortOrder])
}

model CmsPublishEvent {
  id              String   @id @default(cuid())
  pageId          String
  versionId       String
  publishedById   String?
  note            String?
  createdAt       DateTime @default(now())

  page    CmsPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version CmsPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}
