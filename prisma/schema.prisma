  @@index([orderId])
  @@index([autopartCustomerOrderNumber])
  @@index([autopartImportRunId])
}

/// 504C invoice/despatch feed settings — automatic polling defaults OFF.
model Autopart504cFeedSettings {
  id                 String   @id @default("default")
  /// When false (default), scheduler and live Poll Now must not reconcile mailbox files.
  enabled            Boolean  @default(false)
  /// Explicit admin mark that Autopart has configured the report email.
  configured         Boolean  @default(false)
  /// Working-day hours Europe/London — default [13, 16].
  scheduleHoursJson  String   @default("[13,16]")
  workingDaysOnly    Boolean  @default(true)
  allowedSender      String?
  subjectContains    String?  @default("504C")
  filenamePattern    String   @default("*504C*")
  /// Optional dedicated IMAP override; empty = reuse stock Autopart IMAP when enabled later.
  imapHost           String?
  imapPort           Int?
  imapUser           String?
  imapPasswordEnc    String?
  imapSecure         Boolean  @default(true)
  imapMailbox        String?  @default("INBOX")
  lastPolledAt       DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?
}

model Autopart504cImportRun {
  id              String                 @id @default(cuid())
  status          Autopart504cImportStatus
  isDryRun        Boolean                @default(false)
  startedAt       DateTime               @default(now())
  finishedAt      DateTime?
  source          String
  filename        String?
  messageId       String?
  fileHash        String?
  rowsRead        Int                    @default(0)
  abReferencesFound Int                  @default(0)
  ordersMatched   Int                    @default(0)
  newInvoices     Int                    @default(0)
  duplicates      Int                    @default(0)
  credits         Int                    @default(0)
  unmatchedAbRefs Int                    @default(0)
  invalidRows     Int                    @default(0)
  nonAbRows       Int                    @default(0)
  ordersDespatched Int                   @default(0)
  emailsQueued    Int                    @default(0)
  emailsSent      Int                    @default(0)
  emailsFailed    Int                    @default(0)
  diagnostics     Json?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  createdBy User? @relation("Autopart504cImportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([startedAt])
  @@index([status])
  @@index([fileHash])
}

/// Ongoing 504 + TRM21QC feed settings — automatic polling defaults OFF.
model AutopartOngoingSalesFeedSettings {
  id                         String   @id @default("default")
  enabled                    Boolean  @default(false)
  configured                 Boolean  @default(false)
  /// Working-day hours Europe/London — default [13, 18].
  scheduleHoursJson          String   @default("[13,18]")
  workingDaysOnly            Boolean  @default(true)
  allowedSender              String?
  filenamePattern504         String   @default("*504*")
  filenamePatternTrm21qc     String   @default("*TRM21QC*")
  /// Exclude 504C attachments when detecting all-branches 504.
  excludeFilenamePattern504c String   @default("*504C*")
  lastPolledAt               DateTime?
  lastSuccess504At           DateTime?
  lastSuccessTrm21qcAt       DateTime?
  lastError                  String?
  updatedAt                  DateTime @updatedAt
  updatedByUserId            String?
}

// ─── Autopart customer history / credit (NOT AB Orders / accounting ledger) ───

/// Explicit staff-verified report account alias. Never fuzzy/prefix matching.
model AutopartCustomerAccountAlias {
  id        String   @id @default(cuid())
  companyId String
  /// Normalised uppercase exact alias (e.g. YORKMOTO when verified code is YORKMOT).
  alias     String
  verifiedById String
  verifiedAt   DateTime @default(now())
  note         String?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  verifiedBy User    @relation("AutopartAliasVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@unique([companyId, alias])
  @@index([alias])
}

/// Autopart sales/credit document header (historic 561L/SLRB + ongoing 504/TRM21QC).
model AutopartSalesDocument {
  id                   String                      @id @default(cuid())
  /// Nullable until customer account can be mapped (ongoing unmatched).
  companyId            String?
  autopartCustomerCode String
  documentType         AutopartHistoricDocumentType
  documentReference    String
  /// Date-only stored as UTC noon for the calendar day when known.
  documentDate         DateTime?
  goodsNet             Decimal?                    @db.Decimal(12, 2)
  vat                  Decimal?                    @db.Decimal(12, 2)
  grossTotal           Decimal?                    @db.Decimal(12, 2)
  /// Provenance: SLRB | 561L | ONGOING_504 | ONGOING_TRM21QC (combined sources may update).
  source               String                      @default("SLRB")
  importRunId          String?
  reconciliationStatus AutopartSalesReconciliationStatus?
  abOrderId            String?
  abOrderNumber        String?
  has504               Boolean                     @default(false)
  hasTrm21qc           Boolean                     @default(false)
  customerOrderNumber  String?
  customerNameSnapshot String?
  initialsSnapshot     String?
  /// 504 Type column when present (ACCOUNT / CONSOL).
  reportType504        String?
  linesNetSum          Decimal?                    @db.Decimal(12, 2)
  valueMismatchMinor   Int?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  company Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   AutopartSalesLine[]
  importRun AutopartCustomerImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  /// Historic uniqueness remains company-scoped (same Autopart doc can appear under aliases).
  /// Ongoing docs also have a partial unique index on (documentType, documentReference)
  /// WHERE has504 OR hasTrm21qc — see migration 20260930120000.
  @@unique([companyId, documentType, documentReference])
  @@index([companyId, documentDate])
  @@index([autopartCustomerCode])
  @@index([documentReference])
  @@index([reconciliationStatus])
  @@index([abOrderNumber])
  @@index([has504, hasTrm21qc])
}

/// Autopart product line (historic 561L + ongoing TRM21QC). Not an OrderItem.
model AutopartSalesLine {
  id                   String                         @id @default(cuid())
  companyId            String
  documentId           String?
  autopartCustomerCode String
  documentType         AutopartHistoricDocumentType
  documentReference    String
  lineNumber           Int
  sku                  String
  descriptionSnapshot  String?
  /// Signed units (credits negative when normalised).
  units                Decimal                        @db.Decimal(12, 3)
  /// Signed sales net EX VAT (credits negative when normalised).
  salesNet             Decimal                        @db.Decimal(12, 2)
  matchedVariantId     String?
  matchStatus          AutopartHistoricLineMatchStatus @default(NOT_IN_AB_CATALOGUE)
  rawInvAndLn          String?
  /// Deterministic TRM21QC row fingerprint for idempotent line numbers.
  sourceFingerprint    String?
  /// Raw TRM21QC Cost — preserved evidence only; NOT Cost Intelligence authority.
  sourceCost           Decimal?                       @db.Decimal(12, 2)
  sourceMargin         Decimal?                       @db.Decimal(12, 2)
  sourcePerc           Decimal?                       @db.Decimal(8, 3)
  /// Provenance: 561L | ONGOING_TRM21QC
  source               String                         @default("561L")
  importRunId          String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document AutopartSalesDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  importRun AutopartCustomerImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([companyId, documentType, documentReference, lineNumber])
  @@index([companyId, sku])
  /// Product-first Sales Intelligence enquiry (SKU across companies in scope).
  @@index([sku, companyId])
  @@index([matchedVariantId])
  @@index([autopartCustomerCode])
  @@index([documentReference])
  @@index([sourceFingerprint])
}

model AutopartCustomerImportRun {
  id              String                       @id @default(cuid())
  companyId       String?
  type            AutopartCustomerImportType
  status          AutopartCustomerImportStatus
  filename        String?
  filenameSlrb    String?
  fileHash        String?
  fileHashSlrb    String?
  detectedAccount String?
  rowsRead        Int                          @default(0)
  rowsValid       Int                          @default(0)
  rowsImported    Int                          @default(0)
  rowsUpdated     Int                          @default(0)
  rowsSkipped     Int                          @default(0)
  rowsUnmatched   Int                          @default(0)
  issues          Json?
  diagnostics     Json?
  dryRun          Boolean                      @default(true)
  createdById     String?
  createdAt       DateTime                     @default(now())
  completedAt     DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AutopartCustomerImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents AutopartSalesDocument[]
  lines     AutopartSalesLine[]

  @@index([companyId, createdAt])
  @@index([companyId, type, status])
  @@index([type, status, createdAt])
  @@index([fileHash])
}

